generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Game {
  DOTA2
  BRAWL_STARS
  CS2
  DDNET
  MINECRAFT
}

enum QueueStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}

enum TeamStatus {
  ACTIVE
  FINISHED
}

model User {
  id           String        @id @default(cuid())
  nickname     String        @unique
  discord      String        @unique
  passwordHash String
  bio          String        @default("")
  games        Game[]
  createdAt    DateTime      @default(now())
  queue        QueueEntry[]
  memberships  TeamMember[]
  messages     ChatMessage[]
}

model QueueEntry {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game
  teamSize  Int
  mode      String?
  level     String      @default("any")
  language  String
  goal      String
  status    QueueStatus @default(WAITING)
  createdAt DateTime    @default(now())
  expiresAt DateTime

  @@index([game, status, createdAt])
  @@index([userId, status])
}

model Team {
  id        String        @id @default(cuid())
  game      Game
  teamSize  Int
  params    Json
  status    TeamStatus    @default(ACTIVE)
  createdAt DateTime      @default(now())
  members   TeamMember[]
  messages  ChatMessage[]
}

model TeamMember {
  teamId   String
  userId   String
  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@id([teamId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  text      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}
